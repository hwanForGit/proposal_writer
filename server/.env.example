# 사내 LLM Gateway (Envoy AI Gateway)
# 참고: inflab.atlassian.net/wiki/spaces/DO/pages/2739896334/LLM+EndPoint
#
# 로컬 (VPN 필요):
#   OPENAI_API_KEY=<회사 이메일>            (ex: shhwang@inflab.com)
#   OPENAI_BASE_URL=https://ai-gateway.devinflab.com/v1
#
# k8s 내부 (개발/운영 동일):
#   OPENAI_BASE_URL=http://ai-gateway.envoy-ai-gateway.svc.cluster.local/v1
#
# k8s 외부 사내망 (lambda/배치):
#   OPENAI_BASE_URL=https://internal-ai-gateway.devinflab.com/v1   (개발)
#   OPENAI_BASE_URL=https://internal-ai-gateway.inflab.com/v1      (운영)

OPENAI_API_KEY=shhwang@inflab.com
OPENAI_BASE_URL=https://ai-gateway.devinflab.com/v1

# 기본 모델. 게이트웨이가 지원하는 모델명을 그대로 사용.
# 추천: claude-4.5-sonnet (긴 컨텍스트 + 한국어 + 정부 R&D 도메인 강세)
# 대안: gemini-2.5-pro, claude-4.5-opus, gpt-4o 등
OPENAI_MODEL=claude-4.5-sonnet

# 서버 포트 / CORS
PORT=3001
CORS_ORIGIN=http://localhost:5173
